
{
  "expo": {
    "name": "StrongHer",
    "slug": "strong-her-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.strongher",
      "infoPlist": {
        "NSCameraUsageDescription": "StrongHer needs camera access to scan food and log meals.",
        "NSMicrophoneUsageDescription": "StrongHer needs microphone access for trainer voice notes."
      }
    },
    "android": {
      "package": "com.yourname.strongher",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "https://raw.githubusercontent.com/expo/expo/master/templates/expo-template-blank/assets/favicon.png"
    }
  }
}
